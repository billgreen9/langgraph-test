# Environment variables for the Python project
# Copy this file to .env and fill in real values

# OpenAI API key (required for LLM calls)
OPENAI_API_KEY=xx

# Optional: custom OpenAI-compatible base URL (e.g. Azure, proxy, local model)
OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Model name to use
MODEL_NAME=doubao-seed-2-1-pro-260628

# Sampling temperature
TEMPERATURE=0.7

# PostgreSQL 连接串（本机 5432，库 graph-test，密码 123456）
POSTGRES_DSN=postgresql://postgres:123456@localhost:5432/graph-test

# 多级技能目录根路径（后台线程定时从这里加载一级技能）
# SKILLS_DIR=/abs/path/to/skills

# 后台线程扫描 skills 目录的间隔秒数
SKILL_SCAN_INTERVAL=10

# 设为 1 时跳过 LLM，路由/规划全部走关键词兜底（离线演示与测试用）
# SKILL_FORCE_KEYWORD=1
